# Matches palantir-java-format, which Spotless enforces at verify time.
# Without this your editor formats one way on save and the build reformats it
# another way, and you bounce between the two.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces as a line break, so leave them alone.
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
